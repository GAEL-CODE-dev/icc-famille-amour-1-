# Copier en .env et remplir — ne jamais committer le .env réel

# Connexion PostgreSQL Neon (avec sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Serveur
PORT=4000
NODE_ENV=development

# Origine autorisée pour le frontend (CORS)
FRONTEND_ORIGINS=http://localhost:4173

# Secrets d'authentification (générer des valeurs aléatoires longues, différentes en prod)
JWT_ACCESS_SECRET=generate-a-strong-random-access-secret-for-production-32-plus-chars
JWT_REFRESH_SECRET=generate-a-strong-random-refresh-secret-for-production-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Verrouillage de compte après échecs
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
